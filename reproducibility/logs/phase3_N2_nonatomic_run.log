                  case Read_Counter_NonAtomic_Zero
                  solve( CounterZero( ~r ) ▶₁ #vr.7 )
                    case Read_Counter_NonAtomic_Zero
                    solve( CounterZero( ~r ) ▶₁ #vr.9 )
                      case Custodian_Redeem_Success
                      solve( CounterZero( ~r ) ▶₁ #vr.9 )
                        case Read_Counter_NonAtomic_Zero
                        solve( CounterZero( ~r ) ▶₁ #vr.10 )
                          case Custodian_Redeem_Success
                          solve( !KU( ~r ) @ #vk.4 )
                            case Custodian_Issue_Challenge
                            SOLVED // trace found
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
