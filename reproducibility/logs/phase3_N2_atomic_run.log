      qed
    qed
  qed
next
  case case_2
  solve( (#i < #k)  ∥ (#k < #i) )
    case case_1
    solve( Executed( r ) @ #i )
      case Execute_Atomic_First
      solve( !RedeemedGrant( $T, cidU, o, wstar, r ) ▶₀ #i )
